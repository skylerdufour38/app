{
  "name": "App Archive",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "App archive preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python3 -m http.server 8000 --directory /workspaces/app > /tmp/app-archive.log 2>&1 &"
}
